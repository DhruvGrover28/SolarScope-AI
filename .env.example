# Required for stable sessions (Render redeploys/instances must use the same value)
SECRET_KEY=change-me-to-a-long-random-string

# Enable memory-safe segmentation on Render (prevents OOM / 502)
SOLARSCOPE_SAFE_MODE=1

# Cap upload size (bytes). 8000000 ~= 8MB
SOLARSCOPE_MAX_UPLOAD_BYTES=8000000

# Optional: cap max image edge for safe-mode resizing
SOLARSCOPE_MAX_IMAGE_EDGE=1200

# Optional: HuggingFace detector settings
# HF_TOKEN=your_huggingface_token
# HF_DETECT_MODEL=Yifeng-Liu/rt-detr-finetuned-for-satellite-image-roofs-detection
# SOLARSCOPE_HF_RETRY_COUNT=1
# SOLARSCOPE_HF_TIMEOUT_SECONDS=20

