# Required for stable login sessions across deployments
SECRET_KEY=change-me-to-a-long-random-string

# Enable memory-safe mode for Render (prevents OOM during image analysis)
SOLARSCOPE_SAFE_MODE=1

# Optional: cap saved upload size (bytes). Default ~8MB
SOLARSCOPE_MAX_UPLOAD_BYTES=8000000

# Optional: cap max edge size during analysis in safe mode
SOLARSCOPE_MAX_IMAGE_EDGE=1200

# Optional: HuggingFace detector limits
SOLARSCOPE_HF_RETRY_COUNT=1
SOLARSCOPE_HF_TIMEOUT_SECONDS=20

